# 왕실의 나이트
# 8x8 좌표 평면
# 행은 a,b,...,h
# 열은 1~8
# 행과 열을 입력 받고, 해당 위치로부터 나이트가 이동할 수 있는 경우가 몇 개인지 출력
# 나이트는 L자 형태로 이동, x축으로 2칸 y축으로 1칸 혹은 y축으로 2칸 x축으로 1칸
# 총 8개의 경우의 수가 있음

x_list = ['a','b','c','d','e','f','g','h']
y_list = ['1','2','3','4','5','6','7','8']

ans = 0

# 좌표를 입력 받음
position = input()

for x in range (len(x_list)):
    for y in range (len(y_list)):
        if position == x_list[x] + y_list[y]: # 입력받은 좌표의 인덱스 값 찾기
            if (x - 2) >= 0:
                if (y - 1) >= 0:
                    ans += 1
                if (y + 1) <= 7:
                    ans += 1

            if (x + 2) <= 7:
                if (y - 1) >= 0:
                    ans += 1
                if (y + 1) <= 7:
                    ans += 1

            if (x - 1) >= 0:
                if (y - 2) >= 0:
                    ans += 1
                if (y + 2) <= 7:
                    ans += 1

            if (x + 1) <= 7:
                if (y - 2) >= 0:
                    ans += 1
                if (y + 2) <= 7:
                    ans += 1

print(ans)